<?xml version="1.0"?>
<package format="3">
  <name>robot_diagnostics</name>
  <version>0.1.0</version>
  <description>Read-only odometry and velocity command monitoring.</description>
  <maintainer email="maintainers@example.com">robot_diagnostics maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>rmw_fastrtps_cpp</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
